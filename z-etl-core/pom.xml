<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-etl</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-etl-core</artifactId>
    <name>z-etl-core</name>
    <packaging>jar</packaging>

    <description>ETL 引擎核心：job 模型 + reader/transform/writer + 执行器 + 水位与对账</description>

    <dependencies>
        <!-- 零件面：z-util-jdbc 带 DynamicQuery / Dialects / Identifiers（标识符白名单是安全底线，
             见需求 008 notes.md §9.1 / §9.8）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-jdbc</artifactId>
        </dependency>
        <!-- job 描述 JSON 解析 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- job 描述 yml 解析 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- Spring 只作为容器面（core 不含 @ComponentScan，不自带启动器） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MyBatis-Plus：web 模块的 @MapperScan 走本域 sqlSessionFactory -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 本地夹具库：验收项 1/2/3 全部在 H2 上跑，不连任何真实库 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
        <!-- 零件面：z-util-expr 的 EL 引擎（行级表达式）。
             只引 EL 一个子模块：六引擎里 JS 模块没有 JS 引擎、LUA 无沙箱可逃逸（TASK-010 实测），
             本仓对 LUA/JS 硬拒绝 ⇒ 不引 Groovy/Lua/SQL/Obj 子模块，避免把不可用的执行器带进来。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-expr-el</artifactId>
        </dependency>
        <!-- 零件面：z-script-engine（脚本沙箱：GroovySandbox / ElSandbox / SandboxExecutor 超时）。
             行级表达式的 GROOVY 引擎也走这里（z-util-expr 的裸 GroovyExecutor 无沙箱 ⇒ 不启用）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-script-engine</artifactId>
        </dependency>
    </dependencies>

</project>
